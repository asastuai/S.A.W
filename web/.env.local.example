# =====================================================================
# SAW environment variables — copy to web/.env.local and fill in.
# Never commit .env.local — it is gitignored.
# =====================================================================

# ---------------------------------------------------------------------
# LLM (BYOK fallback for local dev only — production users bring their own)
# ---------------------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ---------------------------------------------------------------------
# Supabase — database, auth bridge, realtime, storage
# https://supabase.com/dashboard → your project → Settings → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5...

# 32-byte key for BYOK ciphertext (AES-GCM). Generate with:
#   openssl rand -base64 32
SAW_BYOK_ENC_KEY=

# ---------------------------------------------------------------------
# Privy — auth + embedded wallets (Phantom continues to work alongside)
# https://dashboard.privy.io → your app → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=cl...
PRIVY_APP_SECRET=...

# ---------------------------------------------------------------------
# Trigger.dev — cron workflows for agent wake cycles
# https://cloud.trigger.dev → your project → API keys
# ---------------------------------------------------------------------
TRIGGER_PROJECT_REF=proj_...
TRIGGER_SECRET_KEY=tr_dev_...
NEXT_PUBLIC_TRIGGER_PUBLIC_API_KEY=pk_dev_...

# ---------------------------------------------------------------------
# Sentry — errors
# https://sentry.io → your project → Settings → Client Keys (DSN)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=saw-web

# ---------------------------------------------------------------------
# PostHog — product analytics + session replay
# https://us.posthog.com → Project Settings → Project API key
# ---------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------
# Telegram bot — optional. See docs/telegram-bot-setup.md
# ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://saw-gilt.vercel.app

# ---------------------------------------------------------------------
# Cron — Vercel Cron Jobs hits /api/cron/wake-due-agents every 5 min.
# Set this to a long random string and add it to Vercel project env vars
# under the same name. Vercel automatically attaches it as the Authorization
# header on scheduled invocations.
# Generate: openssl rand -base64 32
# ---------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------
# Treasury — SAW fee collection address (devnet for v1)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SAW_TREASURY=

# ---------------------------------------------------------------------
# Solana RPC (devnet for v1, mainnet gated by funding)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Eventually upgrade to Helius for higher limits + enhanced APIs:
# NEXT_PUBLIC_SOLANA_RPC=https://devnet.helius-rpc.com/?api-key=...
